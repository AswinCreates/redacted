# Vercel (frontend) - set these in Project Settings > Environment Variables:
#   VITE_SOCKET_URL = https://<your-render-backend>.onrender.com   (socket.io gameplay)
#   VITE_API_URL    = https://<your-render-backend>.onrender.com   (REST, e.g. /api/categories)
#
# NOTE: without VITE_SOCKET_URL / VITE_API_URL the frontend falls back to
# http://localhost:3001 which NEVER works on a deployed site.

# Local development defaults (copy to .env):
VITE_SOCKET_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
